# SiYuan kernel address. Desktop default is usually http://127.0.0.1:6806
SIYUAN_BASE_URL=http://127.0.0.1:6806

# Set in SiYuan: Settings -> About -> API token
SIYUAN_TOKEN=

# Optional default notebook. Can be either notebook id or notebook name.
SIYUAN_DEFAULT_NOTEBOOK=

# Optional CodeX/test notebook. All MCP tests, experience notes, and fixtures should use this.
SIYUAN_CODEX_NOTEBOOK=

# Keep raw endpoint access disabled until you need unsupported SiYuan APIs.
SIYUAN_ALLOW_RAW_API=false
